          <mxGeometry height="110" width="225" x="476.9156479289734" y="650.5060240963855" as="geometry" />
        </mxCell>
        <mxCell id="nV8rRp___gUw0dxejpHO-53" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#E7F4EF;strokeColor=#75A99C;strokeWidth=1.8;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#203A52;spacing=10;" value="Qwen2.5-3B 分类模型&#xa;3B 主体参数冻结&#xa;LoRA + 分类头可训练" vertex="1">
          <mxGeometry height="110" width="235" x="751.9156479289734" y="650.5060240963855" as="geometry" />
        </mxCell>
        <mxCell id="nV8rRp___gUw0dxejpHO-54" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F0EDF8;strokeColor=#ABA0CC;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#203A52;spacing=10;" value="模型预测三个类别&#xa;无变化 / 救回 / 误伤&#xa;不是生成解题步骤" vertex="1">
          <mxGeometry height="110" width="260" x="1036.9156479289734" y="650.5060240963855" as="geometry" />
        </mxCell>
        <mxCell id="nV8rRp___gUw0dxejpHO-55" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FFF4DF;strokeColor=#D4AE67;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#203A52;spacing=10;" value="真实训练类别&#xa;来自 Alt / Long 对错比较&#xa;只在训练时用于监督" vertex="1">
          <mxGeometry height="105" width="235" x="751.9156479289734" y="865.5060240963855" as="geometry" />
        </mxCell>
        <mxCell id="nV8rRp___gUw0dxejpHO-56" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F9EDEF;strokeColor=#C798A2;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#203A52;spacing=10;" value="预测与真实类别比较&#xa;计算加权分类误差&#xa;只更新 LoRA 和分类头" vertex="1">
          <mxGeometry height="105" width="260" x="1036.9156479289734" y="865.5060240963855" as="geometry" />
        </mxCell>
        <mxCell id="nV8rRp___gUw0dxejpHO-57" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#F5F7FA;strokeColor=#D3DBE4;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#53697E;spacing=10;" value="按题目与来源划分&#xa;训练 / 校准 / 测试&#xa;同题 repeat 不得跨组" vertex="1">
          <mxGeometry height="105" width="300" x="201.91564792897339" y="865.5060240963855" as="geometry" />
        </mxCell>
